# orchestrator-values.yaml
# Add a top-level image.repository that charts commonly expect:
image:
  repository: your-registry            # e.g. myregistry.example.com or docker.io/your-org
  pullPolicy: IfNotPresent

# Orchestrator values (use an image you build & push from this repo)
orchestrator:
  image:
    repository: ghcr.io/anthonyKiggundu/okra-orchestrator
    tag: "v0.1.0"
  env:
    REDIS_URL: "redis-master.5g.svc.cluster.local:6379"
    CELERY_BROKER_URL: "redis-master.5g.svc.cluster.local:6379/1"
    CELERY_BACKEND_URL: "redis-master.5g.svc.cluster.local:6379/2"
  replicas: 1

celery:
  image:
    repository: ghcr.io/anthonyKiggundu/okra-orchestrator
    tag: "v0.1.0"
  concurrency: 2
